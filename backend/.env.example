# ============================================
# Banco de dados PostgreSQL
# ============================================
# Estes valores são usados tanto pelo docker-compose.yml
# quanto para montar a URL de conexão do Prisma
# (ver prisma.config.ts e src/config/env.ts).
# Se alterar aqui, recrie o container: docker compose up -d --force-recreate

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=product_catalog
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# Servidor
# ============================================
# Porta em que a API vai rodar
PORT=3000
